{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__storybloq__*",
      "mcp__infomaniak-mail__*",
      "mcp__Notion__*",
      "mcp__notion__*",
      "mcp__Apify__*",
      "mcp__apify__*",
      "mcp__Dataforseo__*",
      "mcp__dataforseo__*",
      "mcp__KUMO-tools__*",
      "WebFetch",
      "WebSearch",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @storybloq/storybloq@1.4.4 session compact-prepare"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npm install -g @storybloq/storybloq@1.4.4 >/dev/null 2>&1 || true"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @storybloq/storybloq@1.4.4 session resume-prompt"
          }
        ]
      }
    ]
  }
}
